{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All",
            "type": "shell",
            "command": "make -j",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
        },
        {
            "label": "Build Current",
            "type": "shell",
            "command": "make -j app APP=${relativeFileDirname}",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
        },
    ]
}